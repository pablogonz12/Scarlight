#!/usr/bin/env bash
# Scarlight: Steam compatibility tool for Xbox Series (GDK) titles.
# Steam calls: scarlight <verb> <game exe> [args]
#
# Runs the title's exe through Scarlight (victory.exe) on top of an installed
# Proton's Wine, inside the prefix Steam created for this game. Settings live in
# scarlight.conf next to this script; the log is $STEAM_COMPAT_DATA_PATH/scarlight.log.
# Set SCARLIGHT_DRY_RUN=1 to bind imports without running (no GPU work).
# `scarlight --print` (or SCARLIGHT_PRINT=1) only prints which Proton and which
# path (fast or safe) a launch would use, and why, then exits: no Wine is run.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
verb="${1:-}"
shift || true
PRINT="${SCARLIGHT_PRINT:-}"
if [ "$verb" = --print ]; then PRINT=1; fi

# ---- settings (scarlight.conf overrides these defaults) --------------------
BUILD=default
# Empty: find the GE-Proton this release is built for (BASE, next to this
# script), or else the newest GE-Proton11-* installed. See below.
PROTON=
# auto: the fast path when its Proton and /dev/udmabuf are usable; 0: always safe.
FAST=auto
D3DCOMPILER=
PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/victory/titles"
MESA_CACHE_MAX_SIZE=16G
VKD3D_CONFIG=ignore_shared_fence
EXTRA_ENV=
# A release ships scarlight.conf.example and never overwrites your conf: the
# first launch copies the example into place, an upgrade leaves the conf alone.
if [ ! -f "$HERE/scarlight.conf" ] && [ -f "$HERE/scarlight.conf.example" ]; then
  cp "$HERE/scarlight.conf.example" "$HERE/scarlight.conf" 2>/dev/null || true
fi
if [ -f "$HERE/scarlight.conf" ]; then . "$HERE/scarlight.conf"; fi
# Empty settings mean "the default" (the installed conf ships them empty).
[ -n "${BUILD:-}" ] || BUILD=default
[ -n "${PROFILE_DIR:-}" ] || PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/victory/titles"
[ -n "${MESA_CACHE_MAX_SIZE:-}" ] || MESA_CACHE_MAX_SIZE=16G
[ -n "${VKD3D_CONFIG:-}" ] || VKD3D_CONFIG=ignore_shared_fence
[ -n "${FAST:-}" ] || FAST=auto

# The GE-Proton this build targets: one line, GE-Proton<major>-<release>, in the
# BASE file next to this script (a release ships it; a source checkout has it).
# The release's own version restarts at .1 on every new BASE - docs/RELEASES.md.
BASE="$(sed -n '1{s/[[:space:]]*$//;p;}' "$HERE/BASE" 2>/dev/null || true)"
[ -n "$BASE" ] || BASE=GE-Proton11-14
VERSION="$(sed -n 's/^version=//p' "$HERE/VERSION" 2>/dev/null || true)"

DATA="${STEAM_COMPAT_DATA_PATH:-$HOME/.local/share/scarlight}"
LOG="$DATA/scarlight.log"
mkdir -p "$DATA"

log() { printf '%s %s\n' "$(date +%T)" "$*" >> "$LOG"; }

# ---- which Proton's Wine to run on -----------------------------------------
# A name is looked for in this tool's own compatibilitytools.d first, then in the
# usual Steam folders: inside Steam's runtime container compatibilitytools.d is
# exposed, but not always under the same root as the tool (Flatpak Steam, for one).
CT_DIRS=(
  "$(dirname "$HERE")"
  "$HOME/.local/share/Steam/compatibilitytools.d"
  "$HOME/.steam/root/compatibilitytools.d"
  "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d"
)
GE_URL="https://github.com/GloriousEggroll/proton-ge-custom/releases"

# Prints the folder of the Proton called $1, if a compatibilitytools.d has one.
find_proton() {
  local base
  for base in "${CT_DIRS[@]}"; do
    if [ -x "$base/$1/files/bin/wine" ]; then
      printf '%s\n' "$base/$1"
      return 0
    fi
  done
  return 1
}

# The paired Proton (the fork's own build, installed as $BASE-victory<N>) is
# what the fast path needs: its Wine imports section memory through
# /dev/udmabuf and its vkd3d-proton takes a larger view heap. Prints the newest
# one that has a Wine, compared by name (victory10 beats victory9).
find_paired() {
  local base d
  for base in "${CT_DIRS[@]}"; do
    for d in "$base/$BASE"-victory*; do
      case "$(basename "$d")" in
        "$BASE"-victory[0-9]*) ;;
        *) continue ;;
      esac
      if [ -x "$d/files/bin/wine" ]; then printf '%s\t%s\n' "$(basename "$d")" "$d"; fi
    done
  done | sort -V | tail -1 | cut -f2
}

# Prints the stock GE-Proton to fall back to: BASE as GE names its tarball
# (GE-Proton11-14-x86_64) or as ProtonUp-Qt extracts it (GE-Proton11-14), else
# the newest GE-Proton11-* that is not a paired build.
find_stock() {
  local name base d found
  for name in "$BASE-x86_64" "$BASE"; do
    if find_proton "$name"; then return 0; fi
  done
  # Only an install that has a Wine counts (a leftover folder or a half
  # extracted tarball must not win), and they are compared by name: the newest
  # GE-Proton11-20 beats GE-Proton11-9, whatever directory each sits in.
  found="$(for base in "${CT_DIRS[@]}"; do
    for d in "$base"/GE-Proton11-*; do
      case "$(basename "$d")" in *-victory*) continue ;; esac
      if [ -x "$d/files/bin/wine" ]; then printf '%s\t%s\n' "$(basename "$d")" "$d"; fi
    done
  done | sort -V | tail -1 | cut -f2)"
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

# What the fast path needs from a Proton folder ($1) and from the machine.
# Prints what is missing, one item per line; nothing means it is usable.
UDMABUF="${SCARLIGHT_UDMABUF:-/dev/udmabuf}"
fast_missing() {
  if ! grep -qa VKD3D_VIEW_HEAP_DESCRIPTORS "$1/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12core.dll" 2>/dev/null; then
    echo "$(basename "$1") has no paired vkd3d-proton (no view-heap setting in its d3d12core.dll)"
  fi
  if [ ! -e "$UDMABUF" ]; then
    echo "$UDMABUF does not exist (load it: sudo modprobe udmabuf)"
  elif [ ! -r "$UDMABUF" ] || [ ! -w "$UDMABUF" ]; then
    echo "$UDMABUF is not readable and writable by $(id -un) (see docs/linux-proton.md)"
  fi
}

PAIRED="$(find_paired)"
MISSING=""
if [ "${PROTON#/}" != "$PROTON" ]; then
  PDIR="$PROTON"
elif [ -n "$PROTON" ]; then
  PDIR="$(find_proton "$PROTON")" || PDIR="$(dirname "$HERE")/$PROTON"
elif [ "$FAST" != 0 ] && [ -n "$PAIRED" ] && [ -z "$(fast_missing "$PAIRED")" ]; then
  PDIR="$PAIRED"
else
  # Why the paired build is not used, for the one line below.
  if [ "$FAST" = 0 ]; then
    MISSING="FAST=0 in scarlight.conf"
  elif [ -z "$PAIRED" ]; then
    MISSING="no $BASE-victory<N> in compatibilitytools.d"
  else
    MISSING="$(fast_missing "$PAIRED" | paste -sd ';' - | sed 's/;/; /g')"
  fi
  if ! PDIR="$(find_stock)"; then
    if [ -n "$PAIRED" ]; then
      # No stock Proton to fall back to: run the paired one on the safe settings.
      PDIR="$PAIRED"
    else
      log "no GE-Proton in compatibilitytools.d; $BASE is required ($GE_URL)"
      echo "scarlight: no GE-Proton found in compatibilitytools.d; $BASE is required." >&2
      echo "  Install it from $GE_URL (or set PROTON in this tool's scarlight.conf)." >&2
      exit 1
    fi
  fi
  case "$(basename "$PDIR")" in
    "$BASE" | "$BASE-x86_64" | "$BASE"-victory*) ;;
    *)
      # A newer GE-Proton of the same series usually runs this build; say so once.
      WARN="no $BASE in compatibilitytools.d; using $(basename "$PDIR") (this release expects $BASE)"
      log "$WARN"
      echo "scarlight: $WARN" >&2
      ;;
  esac
fi
# An explicit PROTON still has to pass the same checks before the fast settings go on.
FAST_PROTON=0
if [ -z "$MISSING" ]; then
  if [ "$FAST" = 0 ]; then
    MISSING="FAST=0 in scarlight.conf"
  else
    MISSING="$(fast_missing "$PDIR" | paste -sd ';' - | sed 's/;/; /g')"
  fi
fi
if [ -z "$MISSING" ]; then
  FAST_PROTON=1
  PATH_LINE="fast path on $(basename "$PDIR") (paired vkd3d-proton, $UDMABUF read/write)"
else
  PATH_LINE="safe path on $(basename "$PDIR"): $MISSING; the fast-only settings stay off"
fi
log "$PATH_LINE"
echo "scarlight: $PATH_LINE" >&2
if [ -n "$PRINT" ]; then
  echo "proton=$PDIR"
  echo "fast=$FAST_PROTON"
  if [ "$FAST_PROTON" = 1 ]; then
    echo "env=VICTORY_PORT_CONSTANTS=1 WINE_VICTORY_LOCAL_VIEWS=1 VKD3D_DISABLE_EXTENSIONS=VK_EXT_descriptor_heap VKD3D_VIEW_HEAP_DESCRIPTORS=4194304"
  else
    echo "env=unset VICTORY_PORT_CONSTANTS WINE_VICTORY_LOCAL_VIEWS VKD3D_DISABLE_EXTENSIONS VKD3D_VIEW_HEAP_DESCRIPTORS"
  fi
  exit 0
fi
WINE="$PDIR/files/bin/wine"
WSRV="$PDIR/files/bin/wineserver"
export WINEPREFIX="$DATA/pfx"

case "$verb" in
  getcompatpath) "$WINE" winepath -w "$1" 2>/dev/null; exit ;;
  getnativepath) "$WINE" winepath -u "$1" 2>/dev/null; exit ;;
  waitforexitandrun | run | runinprefix) ;;
  waitforexit) "$WSRV" -w 2>/dev/null; exit 0 ;;
  *)
    echo "scarlight: unknown verb '$verb'" >&2
    exit 1
    ;;
esac

GAME="${1:-}"
shift || true

log "---- $verb build=$BUILD version=${VERSION:-dev} base=$BASE proton=$(basename "$PDIR") game=$GAME"
if [ ! -x "$WINE" ]; then
  log "no Wine at $WINE; $BASE is the GE-Proton this release expects (set PROTON in scarlight.conf)"
  echo "scarlight: no Wine at $WINE; install $BASE from $GE_URL" >&2
  notify-send "Scarlight" "Proton not found: $BASE (edit scarlight.conf)" 2>/dev/null
  exit 1
fi
if [ ! -f "$GAME" ]; then
  log "game exe not found: $GAME"
  exit 1
fi
mkdir -p "$WINEPREFIX"
# A run killed by Steam leaves its wineserver holding the prefix: stop it, then
# wait for it to be gone. Waiting first would block on the very server we want
# gone, so the order matters.
if [ "$verb" = waitforexitandrun ]; then
  "$WSRV" -k 2>/dev/null
  "$WSRV" -w 2>/dev/null
fi

# Scarlight runs from its own folder in the prefix so its DLLs (vkd3d-proton,
# DXC) win over anything else on the search path.
RUN="$WINEPREFIX/drive_c/scarlight"
mkdir -p "$RUN"
EXE="$HERE/files/victory-$BUILD.exe"
if [ ! -f "$EXE" ]; then
  log "no build at $EXE (set BUILD in scarlight.conf)"
  exit 1
fi
# A failed copy must not leave the previous build or a half set of DLLs behind
# and run it as if it were the selected one.
stage() { # stage SRC DEST
  cmp -s "$1" "$2" && return 0
  cp -f "$1" "$2" || {
    log "cannot stage $(basename "$2") from $1"
    exit 1
  }
}
stage "$EXE" "$RUN/victory.exe"
CUSTOM_VKD3D="$PDIR/files/lib/wine/vkd3d-proton/x86_64-windows"
for f in "$HERE"/files/*.dll; do
  [ -e "$f" ] || continue
  base="$(basename "$f")"
  # d3dcompiler_47 is handled below: it is optional, and the conf decides.
  [ "$base" = d3dcompiler_47.dll ] && continue
  if [ "$FAST_PROTON" = 1 ] && [ -f "$CUSTOM_VKD3D/$base" ]; then
    stage "$CUSTOM_VKD3D/$base" "$RUN/$base"
  else
    stage "$f" "$RUN/$base"
  fi
done

# The Proton we run on has its own DXVK DXGI/D3D11 DLLs; a tarball install does
# not carry them, so take them from there. Same files install.sh copies.
DXVK="$PDIR/files/lib/wine/dxvk/x86_64-windows"
for f in dxgi.dll d3d11.dll d3d10core.dll; do
  if [ -f "$DXVK/$f" ]; then stage "$DXVK/$f" "$RUN/$f"; fi
done

# Microsoft's d3dcompiler_47 is optional: it is not redistributable, so it is
# never shipped. Two sources are honoured, an explicit D3DCOMPILER from the conf
# first and a copy sitting in files/ (install.sh --d3dcompiler, or one it found in
# a prefix) second; with neither, Wine's built-in compiler is used and most titles
# still start.
#
# Any copy this script stages is marked, so taking the source away (clearing the
# setting, deleting files/d3dcompiler_47.dll) actually goes back to Wine's built-in
# compiler on the next launch instead of leaving the old file behind. A copy that
# was already in the prefix when we got there is not ours to delete and stays.
MARK="$RUN/.d3dcompiler_47.by-scarlight"
FILES_DC="$HERE/files/d3dcompiler_47.dll"
DC_SRC=""
if [ -n "$D3DCOMPILER" ]; then
  if [ -f "$D3DCOMPILER" ]; then
    DC_SRC="$D3DCOMPILER"
  else
    log "D3DCOMPILER is set but there is no file at $D3DCOMPILER; ignoring it"
  fi
fi
if [ -z "$DC_SRC" ] && [ -f "$FILES_DC" ]; then DC_SRC="$FILES_DC"; fi
if [ -n "$DC_SRC" ]; then
  stage "$DC_SRC" "$RUN/d3dcompiler_47.dll"
  : > "$MARK"
elif [ -f "$MARK" ]; then
  rm -f -- "$RUN/d3dcompiler_47.dll" "$MARK"
  log "no d3dcompiler source left: using Wine's built-in d3dcompiler"
fi

# Title profiles live outside the repo; Wine's HOME is the prefix, so reach the
# Linux config dir through the Z: drive. Without them the hooks that keep the
# title alive are absent.
P="${PROFILE_DIR/#\~/$HOME}"
export VICTORY_PROFILE_DIR="Z:${P//\//\\}"

cd "$RUN" || {
  log "cannot enter $RUN"
  exit 1
}
WGAME="Z:$(printf '%s' "$GAME" | sed 's#/#\\#g')"

export WINEDEBUG="${WINEDEBUG:--all}"
OVERRIDES="d3d12,d3d12core,dxgi,d3d11,d3d10core"
[ -f "$RUN/d3dcompiler_47.dll" ] && OVERRIDES="$OVERRIDES,d3dcompiler_47"
export WINEDLLOVERRIDES="$OVERRIDES=n,b"
export VKD3D_CONFIG
export VK_LOADER_LAYERS_DISABLE="${VK_LOADER_LAYERS_DISABLE-*renderdoc*}"
export NO_COLOR=1 RUST_LOG_STYLE=never
export VICTORY_NO_WATCHDOG=1 VICTORY_LOG="${VICTORY_LOG:-info}"
export MESA_SHADER_CACHE_DIR="$DATA/mesa_cache"
export MESA_SHADER_CACHE_MAX_SIZE="$MESA_CACHE_MAX_SIZE"
for kv in $EXTRA_ENV; do export "${kv?}"; done
export VICTORY_RT_FALLBACK_NO_BVH=1 VICTORY_AMBIENT=0.35 VICTORY_AMBIENT_SHADE=0
export VICTORY_TEXTURE_NO_WAIT=1 VICTORY_RELAY=2 VICTORY_WIDE_BACK=1 VICTORY_CARD_REHASH_RUNS=1
export VICTORY_JOIN_COPIES=1 VICTORY_INDIRECT_WINDOW=1 VICTORY_RELAY_COPY=1 VICTORY_CARD_STEPS=2
export VICTORY_INDIRECT_BATCH=2 VICTORY_MAP_THREADS=1 VICTORY_CARD_AWAKE=1 VICTORY_SHOW_AFTER=1
export VICTORY_THIN=1 VICTORY_JOIN_PARTS=8 VICTORY_UPLOAD_AHEAD=1 VICTORY_PORT_DESCRIPTORS=1
export VICTORY_PORT_CBV=1 VICTORY_PORT_GUARD=1 VICTORY_PORT_JOURNAL=1 VICTORY_WC_NO_BACK=1
export VICTORY_CARD_BUFFERS_MIN_MB=1
if [ "$FAST_PROTON" = 1 ]; then
  export VICTORY_PORT_CONSTANTS=1 WINE_VICTORY_LOCAL_VIEWS=1
  export VKD3D_DISABLE_EXTENSIONS=VK_EXT_descriptor_heap VKD3D_VIEW_HEAP_DESCRIPTORS=4194304
else
  # The constants path on a Proton without the paired Wine and vkd3d-proton
  # draws a black picture: clear it even when the conf or the caller set it.
  unset VICTORY_PORT_CONSTANTS WINE_VICTORY_LOCAL_VIEWS VKD3D_VIEW_HEAP_DESCRIPTORS
  if [ "${VKD3D_DISABLE_EXTENSIONS:-}" = VK_EXT_descriptor_heap ]; then unset VKD3D_DISABLE_EXTENSIONS; fi
fi

# victory's own options come first; the title's arguments come after `--`, as
# its CLI declares them (`#[arg(last = true)]`). Without the separator a title
# argument such as `-windowed` would be parsed by victory and stop the launch,
# and one called `--execute` could start the title during a dry run.
TITLE_ARGS=()
[ $# -gt 0 ] && TITLE_ARGS=(-- "$@")
if [ -n "${SCARLIGHT_DRY_RUN:-}" ]; then
  log "start (dry run): $RUN/victory.exe run $WGAME (imports only, no --execute)"
  "$WINE" "$RUN/victory.exe" run "$WGAME" "${TITLE_ARGS[@]}" >> "$LOG" 2>&1
else
  log "start: $RUN/victory.exe run $WGAME --execute"
  "$WINE" "$RUN/victory.exe" run "$WGAME" --execute "${TITLE_ARGS[@]}" >> "$LOG" 2>&1
fi
rc=$?
log "exit $rc"
[ "$verb" = waitforexitandrun ] && "$WSRV" -w 2>/dev/null
exit $rc
