menu_presets() {
  local c
  while :; do
    c=$(ui_pick "Presets" "one press, everything set; then Play from the main menu" \
      play "Play - normal start, shader cache, watchdog off, log info" \
      perf "Performance - Play, plus every fast Mesa switch this driver has" \
      pic  "Picture debug - ray tracing when the build has it, shader stats, log debug" \
      dev  "Developer - skip the intros, land on the test scene, log debug" \
      back "Back") || return 0
    case "$c" in
      back) return 0 ;;
      *) apply_preset "$c"; ui_show "Preset" "$(preset_word) is set. Press Play on the main menu to start." ;;
    esac
