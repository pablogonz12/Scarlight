#!/usr/bin/env bash
# scarlight - the launcher for Scarlight on Linux + Mesa.
#
# It checks the machine, keeps your setup in a profile, explains every switch and
# starts the port under Wine/Proton. No game files are read or written, and no
# title names are baked in: every path is one you gave it.
#
# usage: scarlight [--check] [--dry-run] [--profile NAME] [--save-profile NAME]
#                  [--list-profiles] [--ui gum|fzf|whiptail|dialog|select]
#                  [--yes] [--help]
#
# environment:
#   SCARLIGHT_UI              force the front end (gum|fzf|whiptail|dialog|select)
#   SCARLIGHT_CONFIG_DIR      where profiles (*.env) live, default ~/.config/scarlight
#   SCARLIGHT_DEFAULT_PREFIX  default WINEPREFIX
#   SCARLIGHT_DEFAULT_GAME_EXE  default game exe when a profile does not name one
#   SCARLIGHT_DEFAULT_PROTON    default Proton/GE folder when a profile does not name one
#   SCARLIGHT_LAUNCH_CMD      command template that starts the game inside the env
#                             ({exe}, {port_exe} and {prefix} are substituted, quoted)
#   SCARLIGHT_NO_COLOR=1      plain text
set -uo pipefail

PROG=scarlight
CONFIG_DIR=${SCARLIGHT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/scarlight}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/share}/scarlight
LOG_DIR=$STATE_DIR/logs
CACHE_DIR=$STATE_DIR/cache

# ---------- output ---------------------------------------------------------
CLR=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${SCARLIGHT_NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  CLR=1
fi
C_OK=""; C_WARN=""; C_BAD=""; C_DIM=""; C_B=""; C_R=""
if [ "$CLR" = 1 ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_BAD=$'\033[31m'
  C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_R=$'\033[0m'
fi

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------- arguments ------------------------------------------------------
MODE_CMD=menu          # menu | check | dry
WANT_PROFILE=""
WANT_SAVE=""
ASSUME_YES=0
UI_FORCE=${SCARLIGHT_UI:-${SCAR_UI:-}}

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE_CMD=check ;;
    --dry-run|--print) MODE_CMD=dry ;;
    --yes|-y|--force) ASSUME_YES=1 ;;
    --profile) WANT_PROFILE=${2:-}; [ -n "$WANT_PROFILE" ] || die "--profile needs a name"; shift ;;
    --save-profile) WANT_SAVE=${2:-}; [ -n "$WANT_SAVE" ] || die "--save-profile needs a name"; shift ;;
    --list-profiles)
      mkdir -p "$CONFIG_DIR"
      for f in "$CONFIG_DIR"/*.env; do [ -r "$f" ] && printf '%s\n' "${f##*/}" | sed 's/\.env$//'; done
      exit 0 ;;
    --ui) UI_FORCE=${2:-}; [ -n "$UI_FORCE" ] || die "--ui needs a name"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

# ---------- state ----------------------------------------------------------
DEFAULT_PREFIX=${SCARLIGHT_DEFAULT_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/scarlight/prefix}

PROFILE_NAME=""
PROTON=${SCARLIGHT_DEFAULT_PROTON:-}   # GE-Proton / Proton directory
WINE=""                 # wine binary (empty: <proton>/files/bin/wine)
PORT_EXE=""             # the Scarlight build (victory.exe)
GAME_EXE=${SCARLIGHT_DEFAULT_GAME_EXE:-}   # the title's exe, yours
GAME_DIR=""             # its folder (kept for builds that need it)
DLLDIR=""               # where dxgi/d3d12/d3d12core/dxil live
PREFIX=$DEFAULT_PREFIX
BACKEND=d3d12
RT=off
PRESET=play
TARGET=normal
MESA="mesa-cache"
LOG=info
WATCHDOG=off
# carried for local runners only (the GPU queue lives outside this tool)
TREE=""; SAVE=""; DURATION=420; MODE=play; SCENE=window; EXE=""

load_file() { # load_file <path>
  [ -r "$1" ] || return 1
  # shellcheck source=/dev/null
  . "$1"
  if [ -z "$PORT_EXE" ] && [ -n "${EXE:-}" ]; then PORT_EXE=$EXE; fi
  [ -n "$GAME_EXE" ] && [ -z "$GAME_DIR" ] && GAME_DIR=${GAME_EXE%/*}
  return 0
}

LAST=$CONFIG_DIR/last.env
DEFAULT_PROFILE=$CONFIG_DIR/default.env
mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$CACHE_DIR"

if [ -n "$WANT_PROFILE" ]; then
  pf=$CONFIG_DIR/$WANT_PROFILE.env
  [ -r "$pf" ] || die "no profile: $pf (see --list-profiles)"
  load_file "$pf" || die "cannot read $pf"
  PROFILE_NAME=$WANT_PROFILE
else
  # defaults first, the last session second: what you just changed must survive a restart
  load_file "$DEFAULT_PROFILE" || true
  load_file "$LAST" || true
fi

# ---------- front end ------------------------------------------------------
missing_ui=""
if [ -n "$UI_FORCE" ]; then
  case "$UI_FORCE" in
    gum) have gum || missing_ui=gum ;;
    fzf) have fzf || missing_ui=fzf ;;
    whiptail) have whiptail || missing_ui=whiptail ;;
    dialog) have dialog || missing_ui=dialog ;;
    select) : ;;
    *) die "unknown front end: $UI_FORCE (gum|fzf|whiptail|dialog|select)" ;;
  esac
fi
UI=""
if [ -n "$UI_FORCE" ] && [ -z "$missing_ui" ]; then
  UI=$UI_FORCE
else
  if [ -n "$missing_ui" ]; then
    printf '%s: %s is not installed, using what this machine has\n' "$PROG" "$missing_ui" >&2
  fi
  if have gum && [ -t 0 ] && [ -t 1 ]; then UI=gum
  elif have fzf && [ -t 0 ] && [ -t 1 ]; then UI=fzf
  elif have whiptail && [ -t 0 ] && [ -t 1 ]; then UI=whiptail
  elif have dialog && [ -t 0 ] && [ -t 1 ]; then UI=dialog
  else UI=select; fi
fi

# ui_pick <title> <prompt> <tag> <label> [<tag> <label> ...] -> tag on stdout
ui_pick() {
  local title=$1 prompt=$2; shift 2
  local -a tags=() labels=()
  while [ $# -ge 2 ]; do tags+=("$1"); labels+=("$2"); shift 2; done
  [ ${#tags[@]} -gt 0 ] || return 1
  local out="" i=0 found=-1
  case "$UI" in
    whiptail)
      local -a args=()
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do args+=("${tags[$i]}" "${labels[$i]}"); i=$((i+1)); done
      out=$(whiptail --title "$title" --menu "$prompt" 24 100 15 "${args[@]}" 3>&1 1>&2 2>&3) || return 1
      printf '%s\n' "$out"; return 0 ;;
    dialog)
      local -a dargs=()
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do dargs+=("${tags[$i]}" "${labels[$i]}"); i=$((i+1)); done
      out=$(dialog --stdout --title "$title" --menu "$prompt" 24 100 15 "${dargs[@]}") || return 1
      printf '%s\n' "$out"; return 0 ;;
    gum)
      out=$(printf '%s\n' "${labels[@]}" | gum choose --height 20 \
            --header "$title: $prompt" 2>/dev/null) || return 1 ;;
    fzf)
      out=$(printf '%s\n' "${labels[@]}" | fzf --height=50% --reverse --no-info \
            --prompt "$title> " 2>/dev/null) || return 1 ;;
    *)
      printf '%s%s%s: %s\n' "$C_B" "$title" "$C_R" "$prompt" >&2
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do
        printf '  %d) %s\n' "$((i+1))" "${labels[$i]}" >&2
        i=$((i+1))
      done
      printf 'number (empty = back): ' >&2
      local n=""
      read -r n || return 1
      [ -n "$n" ] || return 1
      case "$n" in ''|*[!0-9]*) return 1 ;; esac
      [ "$n" -ge 1 ] && [ "$n" -le ${#tags[@]} ] || return 1
      printf '%s\n' "${tags[$((n-1))]}"
      return 0 ;;
  esac
  [ -n "$out" ] || return 1
  i=0
  while [ "$i" -lt ${#labels[@]} ]; do
    if [ "${labels[$i]}" = "$out" ]; then found=$i; break; fi
    i=$((i+1))
  done
  [ "$found" -ge 0 ] || return 1
  printf '%s\n' "${tags[$found]}"
}

# ui_check <title> <prompt> <tag> <label> <ON|OFF> [...] -> tags, space separated
ui_check() {
  local title=$1 prompt=$2; shift 2
  local -a tags=() labels=() states=()
  while [ $# -ge 3 ]; do tags+=("$1"); labels+=("$2"); states+=("$3"); shift 3; done
  [ ${#tags[@]} -gt 0 ] || return 1
  local i=0 out="" cur="" line
  while [ "$i" -lt ${#tags[@]} ]; do
    [ "${states[$i]}" = ON ] && cur="$cur ${tags[$i]}"
    i=$((i+1))
  done
  case "$UI" in
    whiptail)
      local -a args=()
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do args+=("${tags[$i]}" "${labels[$i]}" "${states[$i]}"); i=$((i+1)); done
      out=$(whiptail --title "$title" --checklist "$prompt" 26 100 17 "${args[@]}" 3>&1 1>&2 2>&3) || return 1
      out=$(printf '%s' "$out" | tr -d '"') ;;
    dialog)
      local -a dargs=()
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do dargs+=("${tags[$i]}" "${labels[$i]}" "${states[$i]}"); i=$((i+1)); done
      out=$(dialog --stdout --title "$title" --checklist "$prompt" 26 100 17 "${dargs[@]}") || return 1
      out=$(printf '%s' "$out" | tr -d '"') ;;
    gum)
      local -a sel=()
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do
        [ "${states[$i]}" = ON ] && sel+=("${labels[$i]}")
        i=$((i+1))
      done
      local selarg=""
      selarg=$(printf '%s\n' "${sel[@]+"${sel[@]}"}" | paste -sd, -)
      if gum choose --help 2>&1 | grep -q -- '--selected='; then
        out=$(printf '%s\n' "${labels[@]}" | gum choose --no-limit --height 22 \
              --header "$title: $prompt (space toggles, enter keeps)" \
              --selected "$selarg" 2>/dev/null) || return 1
      else
        out=$(printf '%s\n' "${labels[@]}" | gum choose --no-limit --height 22 \
              --header "$title: $prompt (space toggles, enter keeps the current set)" 2>/dev/null) || return 1
      fi
      [ -n "$out" ] || { printf '%s\n' "$cur"; return 0; }
      i=0
      while IFS= read -r line; do
        local j=0
        while [ "$j" -lt ${#labels[@]} ]; do
          if [ "${labels[$j]}" = "$line" ]; then out_tag "${tags[$j]}"; fi
          j=$((j+1))
        done
      done <<EOF
$out
EOF
      return 0 ;;
    fzf)
      out=$(printf '%s\n' "${labels[@]}" | fzf --multi --height=50% --reverse --no-info \
            --header "$title: $prompt" --prompt "$title> " --bind 'space:toggle+down' 2>/dev/null) || return 1
      [ -n "$out" ] || { printf '%s\n' "$cur"; return 0; }
      while IFS= read -r line; do
        local k=0
        while [ "$k" -lt ${#labels[@]} ]; do
          if [ "${labels[$k]}" = "$line" ]; then out_tag "${tags[$k]}"; fi
          k=$((k+1))
        done
      done <<EOF
$out
EOF
      return 0 ;;
    *)
      printf '%s%s%s: %s\n' "$C_B" "$title" "$C_R" "$prompt" >&2
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do
        printf '  %d) [%s] %s\n' "$((i+1))" "${states[$i]}" "${labels[$i]}" >&2
        i=$((i+1))
      done
      printf 'numbers to toggle (empty = keep): ' >&2
      local nums=""
      read -r nums || nums=""
      if [ -z "$nums" ]; then printf '%s\n' "$cur"; return 0; fi
      for n in $nums; do
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "$n" -ge 1 ] && [ "$n" -le ${#states[@]} ] || continue
        if [ "${states[n-1]}" = ON ]; then states[n-1]=OFF; else states[n-1]=ON; fi
      done
      i=0
      while [ "$i" -lt ${#tags[@]} ]; do
        [ "${states[$i]}" = ON ] && printf '%s ' "${tags[$i]}"
        i=$((i+1))
      done
      printf '\n'
      return 0 ;;
  esac
  printf '%s\n' "$out"
}

out_tag() { printf '%s ' "$1"; }

# ui_input <title> <prompt> <default> -> string on stdout
ui_input() {
  local title=$1 prompt=$2 def=${3:-} out=""
  case "$UI" in
    whiptail) out=$(whiptail --title "$title" --inputbox "$prompt" 11 84 "$def" 3>&1 1>&2 2>&3) || return 1 ;;
    dialog) out=$(dialog --stdout --title "$title" --inputbox "$prompt" 11 84 "$def") || return 1 ;;
    gum) out=$(gum input --header "$title: $prompt" --value "$def" --width 84 2>/dev/null) || return 1 ;;
    fzf) out=$(printf '%s\n' "$def" | sed '/^$/d' | fzf --height=10% --reverse --no-info --print-query \
           --prompt "$title> " 2>/dev/null | head -1) || out="" ;;
    *) printf '%s: %s [%s]: ' "$title" "$prompt" "$def" >&2; read -r out || out="" ;;
  esac
  [ -n "$out" ] || out=$def
  printf '%s\n' "$out"
}

# ui_show <title> <text>
ui_show() {
  case "$UI" in
    whiptail) whiptail --title "$1" --scrolltext --msgbox "$2" 24 100 3>&1 1>&2 2>&3 >/dev/null || true ;;
    dialog) dialog --title "$1" --msgbox "$2" 24 100 >/dev/null || true ;;
    *) printf '\n%s%s%s\n%s\n\n' "$C_B" "$1" "$C_R" "$2" >&2 ;;
  esac
  return 0
}

# ui_confirm <title> <text> -> 0 yes
ui_confirm() {
  local a=""
  case "$UI" in
    whiptail) whiptail --title "$1" --yesno "$2" 20 96 3>&1 1>&2 2>&3 ;;
    dialog) dialog --title "$1" --yesno "$2" 20 96 ;;
    gum) gum confirm --prompt.foreground 6 "$2" 2>/dev/null ;;
    *) printf '%s: %s [Y/n] ' "$1" "$2" >&2; read -r a || return 1
       case "${a:-y}" in [Yy]*) return 0 ;; *) return 1 ;; esac ;;
  esac
}

# ui_pause: give the check screen a beat before a menu covers it
ui_pause() {
  case "$UI" in
    whiptail|dialog|gum|fzf) return 0 ;;
    *) [ -t 0 ] || return 0; printf '%spress enter%s ' "$C_DIM" "$C_R" >&2; read -r _ || true ;;
  esac
}

# ---------- machine facts --------------------------------------------------
GPU_NAME=""; DRIVER=""; DRIVER_INFO=""; VKVER=""; MESA_VER=""

detect_gpu() {
  GPU_NAME=""; DRIVER=""; DRIVER_INFO=""; VKVER=""; MESA_VER=""
  have vulkaninfo || return 1
  local s rows pick
  s=$(vulkaninfo --summary 2>/dev/null) || return 1
  [ -n "$s" ] || return 1
  rows=$(printf '%s\n' "$s" | awk '
    /^GPU[0-9]+:/ { n++; next }
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (match(line, /^apiVersion[ \t]*=[ \t]*/))      { api[n] = substr(line, RLENGTH + 1) }
      else if (match(line, /^driverName[ \t]*=[ \t]*/)) { dn[n]  = substr(line, RLENGTH + 1) }
      else if (match(line, /^driverInfo[ \t]*=[ \t]*/)) { di[n]  = substr(line, RLENGTH + 1) }
      else if (match(line, /^deviceName[ \t]*=[ \t]*/)) { dev[n] = substr(line, RLENGTH + 1) }
    }
    END { for (i = 1; i <= n; i++) printf "%s\t%s\t%s\t%s\n", dn[i], api[i], di[i], dev[i] }')
  [ -n "$rows" ] || return 1
  pick=$(printf '%s\n' "$rows" | awk -F'\t' '$1 ~ /^(radv|anv|nvk|lavapipe)$/ { print; exit }')
  [ -n "$pick" ] || pick=$(printf '%s\n' "$rows" | head -1)
  DRIVER=$(printf '%s' "$pick" | cut -f1)
  VKVER=$(printf '%s' "$pick" | cut -f2)
  DRIVER_INFO=$(printf '%s' "$pick" | cut -f3)
  GPU_NAME=$(printf '%s' "$pick" | cut -f4)
  MESA_VER=$(printf '%s' "$DRIVER_INFO" | sed -n 's/.*Mesa[[:space:]]\([0-9][0-9.]*\).*/\1/p')
  case "$VKVER" in
    *.*) : ;;
    [0-9][0-9]*) VKVER=$(awk -v v="$VKVER" 'BEGIN{ printf "%d.%d.%d", int(v/4194304), int(v/4096)%1024, v%4096 }') ;;
  esac
  return 0
}

mem_gb() { awk '/^MemTotal:/ { printf "%d", $2 / 1048576 }' /proc/meminfo 2>/dev/null; }

proton_dirs() {
  local d
  for d in "$HOME"/.steam/steam/steamapps/common/Proton* \
           "$HOME"/.steam/root/steamapps/common/Proton* \
           "$HOME"/.local/share/Steam/steamapps/common/Proton* \
           "$HOME"/.steam/steam/compatibilitytools.d/* \
           "$HOME"/.steam/root/compatibilitytools.d/* \
           "$HOME"/.local/share/Steam/compatibilitytools.d/* \
           "$HOME"/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/common/Proton* \
           "$HOME"/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d/* \
           "$HOME"/.local/share/lutris/runners/proton/*; do
    [ -x "$d/files/bin/wine" ] && printf '%s\n' "$d"
  done | sort -u
}

wine_bin() {
  if [ -n "$WINE" ]; then printf '%s\n' "$WINE"
  elif [ -n "$PROTON" ]; then printf '%s\n' "$PROTON/files/bin/wine"
  else printf 'wine\n'; fi
}

# the folders where the D3D12/DXVK/DXC DLLs are expected, best first
dll_dirs() {
  local seen=" " d
  for d in "${DLLDIR:-}" "${PORT_EXE%/*}" "${GAME_DIR:-}"; do
    [ -n "$d" ] || continue
    [ -d "$d" ] || continue
    case "$seen" in *" $d "*) continue ;; esac
    seen="$seen$d "
    printf '%s\n' "$d"
  done
}

# ---------- the Mesa gate --------------------------------------------------
# A switch is offered only when the installed driver really has it: the Mesa
# Vulkan library is asked for the variable name, and the driver/version is the
# fallback when that library cannot be read.
mesa_libs() {
  local j p
  for j in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json "$HOME"/.local/share/vulkan/icd.d/*.json; do
    [ -r "$j" ] || continue
    p=$(grep -o '"library_path"[^,}]*' "$j" 2>/dev/null | sed 's/.*:[[:space:]]*"//; s/".*//')
    case "$p" in /*) [ -r "$p" ] && printf '%s\n' "$p" ;; esac
  done | sort -u
}

# mesa_lib_has <VAR>: 0 present, 1 absent (the library was readable), 2 unknown
mesa_lib_has() {
  local var=$1 pat lib readable=0
  case "$DRIVER" in
    radv) pat='radeon' ;;
    anv) pat='intel' ;;
    nvk) pat='nouveau' ;;
    *) pat='' ;;
  esac
  while IFS= read -r lib; do
    [ -n "$lib" ] || continue
    case "$lib" in *"$pat"*) : ;; *) continue ;; esac
    readable=1
    if grep -a -m1 -q -F "$var" "$lib" 2>/dev/null; then return 0; fi
  done <<EOF
$(mesa_libs)
EOF
  [ "$readable" = 1 ] && return 1
  return 2
}

mesa_version_ge() { # mesa_version_ge <major>
  [ -n "$MESA_VER" ] || return 1
  awk -v v="$MESA_VER" -v m="$1" 'BEGIN{ split(v,a,"."); exit !(a[1]+0 >= m+0) }'
}

# mesa_flag_ok <tag> -> 0 when the installed Mesa has that switch
mesa_flag_ok() {
  local tag=$1 var
  case "$tag" in
    mesa-cache) var=MESA_SHADER_CACHE_MAX_SIZE ;;
    mesa-nocache) var=MESA_SHADER_CACHE_DISABLE ;;
    wsi-imm) var=MESA_VK_WSI_PRESENT_MODE ;;
    radv-wave32) var=RADV_PERFTEST ;;
    radv-stats|radv-isa) var=RADV_DEBUG ;;
    aco-ir) var=ACO_DEBUG ;;
    vkd3d-cpu) return 0 ;;
    *) return 1 ;;
  esac
  case "$tag" in
    radv-*) [ "$DRIVER" = radv ] || return 1 ;;
    aco-ir) [ "$DRIVER" = radv ] || return 1 ;;
  esac
  case "$tag" in
    wsi-imm) mesa_version_ge 20 || return 1 ;;
    radv-wave32) mesa_version_ge 22 || return 1 ;;
  esac
  local rc
  mesa_lib_has "$var"
  rc=$?
  # 0 present; 1 absent from a library we could read (do not offer); 2 unreadable (trust driver+version)
  [ "$rc" = 1 ] && return 1
  return 0
}

mesa_flag_label() {
  case "$1" in
    mesa-cache)   printf 'Shader cache, 10 GB (MESA_SHADER_CACHE_MAX_SIZE) - warm starts, less stutter' ;;
    mesa-nocache) printf 'No shader cache (MESA_SHADER_CACHE_DISABLE) - cold-cache A/B runs only' ;;
    radv-wave32)  printf 'Wave32 for PS/CS (RADV_PERFTEST) - slower or faster per scene; RADV only' ;;
    radv-stats)   printf 'Pipeline statistics (RADV_DEBUG=shaderstats) - for a perf report; slow' ;;
    radv-isa)     printf 'Dump shader ISA (RADV_DEBUG=shaders) - very slow, for a bug report' ;;
    aco-ir)       printf 'ACO IR validation (ACO_DEBUG) - catches driver bugs, very slow' ;;
    wsi-imm)      printf 'Uncapped present (MESA_VK_WSI_PRESENT_MODE=immediate) - can tear' ;;
    vkd3d-cpu)    printf 'vkd3d-proton CPU paths (ignore fence, pool reuse) - safest default' ;;
    *) printf '%s' "$1" ;;
  esac
}

mesa_available_tags() {
  local t
  for t in mesa-cache mesa-nocache vkd3d-cpu wsi-imm radv-wave32 radv-stats radv-isa aco-ir; do
    mesa_flag_ok "$t" && printf '%s\n' "$t"
  done
}

# ---------- ray tracing support -------------------------------------------
rt_supported() {
  [ "${SCARLIGHT_RT_SUPPORTED:-}" = 1 ] && return 0
  [ "${SCARLIGHT_RT_SUPPORTED:-}" = 0 ] && return 1
  [ -n "$PORT_EXE" ] || return 1
  case "${PORT_EXE%.exe}" in
    *-rt) return 0 ;;
  esac
  [ -e "${PORT_EXE%.exe}.rt" ] && return 0
  return 1
}

# ---------- system check ---------------------------------------------------
CHK_L=(); CHK_T=(); CHK_F=()
chk() { CHK_L+=("$1"); CHK_T+=("$2"); CHK_F+=("${3:-}"); }

# ---------- title profiles -------------------------------------------------
# A profile says what one build of the title needs beyond the generic path
# (code hooks, shaders to leave out). It is optional: without one the layer
# runs with no title patches. The loader reads the first folder that holds one
# for the image it is about to run: VICTORY_PROFILE_DIR, %APPDATA%\victory\
# titles inside the prefix, then $XDG_CONFIG_HOME/victory/titles
# (~/.config/victory/titles). Format: docs/title-profiles.md.
# VICTORY_PROFILE_DIR is written for the Windows side (`Z:\home\you\...`),
# so translate a drive path back to Unix: `Z:` is /, any other drive is the
# prefix's drive_c. Nothing is done to a path that is already Unix.
unix_path() { # unix_path <path>
  case "$1" in
    [A-Za-z]:[\\/]*)
      local drive=${1%%:*} rest=${1#?:}
      rest=${rest//\\//}
      rest=${rest#/}
      case "$drive" in
        z|Z) printf '/%s\n' "$rest" ;;
        *) printf '%s\n' "${PREFIX:-/nonexistent}/drive_${drive,,}/$rest" ;;
      esac ;;
    *) printf '%s\n' "$1" ;;
  esac
}

profile_dirs() {
  local d
  [ -n "${VICTORY_PROFILE_DIR:-}" ] && unix_path "$VICTORY_PROFILE_DIR"
  for d in "${PREFIX:-/nonexistent}"/drive_c/users/*/AppData/Roaming/victory/titles; do
    [ -d "$d" ] && printf '%s\n' "$d"
  done
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/victory/titles"
}

# every profile file the folders above hold
profile_files() {
  local d f
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    for f in "$d"/*.toml; do
      [ -f "$f" ] && printf '%s\n' "$f"
    done
  done <<EOF
$(profile_dirs | awk '!seen[$0]++')
EOF
}

# Ask the build itself (same lookup order, same hash) and translate the one
# line it prints. Without a prefix or Wine it falls back to what the folders
# hold, which is all a launch would find either.
check_title_profile() {
  local w out line f
  [ -n "$PORT_EXE" ] && [ -f "$PORT_EXE" ] || return 0
  [ -n "$GAME_EXE" ] && [ -f "$GAME_EXE" ] || return 0
  w=$(wine_bin)
  # `wine` may come from PATH: ask for it instead of testing the string.
  if [ -d "$PREFIX" ] && command -v -- "$w" >/dev/null 2>&1 && have timeout; then
    out=$(WINEPREFIX="$PREFIX" WINEDEBUG=-all VICTORY_LOG=error timeout 120 \
          "$w" "$PORT_EXE" title-id "$GAME_EXE" 2>/dev/null) || out=""
    line=$(printf '%s\n' "$out" | awk '/^profile /{ sub(/^profile +/, ""); print; exit }')
    if [ -n "$line" ]; then
      case "$line" in
        # The build prints "none" or "none (searched ...)"; a profile path may
        # start with "none" too, so match the sentinel exactly.
        none|"none ("*) chk warn "No title profile for this build" \
                 "the layer runs with no title patches; a profile is optional, see docs/title-profiles.md (VICTORY_PROFILE_DIR)" ;;
        *) chk ok "Title profile: $line" ;;
      esac
      return 0
    fi
  fi
  f=$(profile_files | head -n 1)
  if [ -n "$f" ]; then
    chk ok "Title profile: $f (the build decides at launch whether it is its own)"
  else
    chk warn "No title profile for this build" \
             "the layer runs with no title patches; a profile is optional, see docs/title-profiles.md (VICTORY_PROFILE_DIR)"
  fi
}

run_checks() {
  CHK_L=(); CHK_T=(); CHK_F=()
  local k maj ram p d w have_d3d12=0 have_dxil=0

  if ! have vulkaninfo; then
    chk fail "Vulkan: vulkaninfo is missing, so the driver cannot be read" \
            "install the Vulkan tools (Arch: sudo pacman -S vulkan-tools)"
  elif ! detect_gpu; then
    chk fail "Vulkan: vulkaninfo reports no usable device" \
            "install the Mesa ICD for your card (Arch: vulkan-radeon, vulkan-intel, vulkan-nouveau), then reboot"
  else
    case "$DRIVER" in
      radv|anv|nvk)
        chk ok "GPU: $GPU_NAME" ;;
      *)
        chk fail "GPU: ${GPU_NAME:-unknown} - driver ${DRIVER:-unknown} is not Mesa" \
                "Scarlight targets open-source Mesa: install mesa + the ICD for your card and remove the proprietary one from /etc/vulkan/icd.d" ;;
    esac
    if [ -n "$VKVER" ]; then
      if awk -v v="$VKVER" 'BEGIN{ split(v,a,"."); exit !(a[1]+0 > 1 || (a[1]+0 == 1 && a[2]+0 >= 3)) }'; then
        chk ok "Vulkan $VKVER" ""
      else
        chk fail "Vulkan $VKVER is older than 1.3" \
                "update Mesa (Arch: sudo pacman -Syu mesa vulkan-radeon)"
      fi
    fi
    if [ -n "$MESA_VER" ]; then
      if mesa_version_ge 24; then
        chk ok "Mesa $MESA_VER${DRIVER:+ ($DRIVER)}" ""
      else
        chk warn "Mesa $MESA_VER is older than the versions this port is tested on" \
                 "Mesa 24 or newer is expected; newer RADV has fixes the port relies on"
      fi
    else
      chk warn "Mesa version not reported by the driver" \
               "check 'vulkaninfo --summary' shows driverInfo with \"Mesa x.y.z\"; update Mesa"
    fi
  fi

  k=$(uname -r)
  maj=${k%%.*}
  case "$maj" in ''|*[!0-9]*) chk warn "Kernel: $k" "cannot read a version from uname -r" ;;
    *) if [ "$maj" -ge 6 ]; then chk ok "Kernel $k"; else
         chk warn "Kernel $k is older than 6.x" "newer amdgpu/RADV fixes want kernel 6.12+ (Arch: sudo pacman -Syu linux)"
       fi ;;
  esac

  ram=$(mem_gb)
  if [ -n "$ram" ]; then
    if [ "$ram" -lt 8 ]; then
      chk fail "RAM: ${ram} GB" "8 GB is the floor; the port and the title both need the same memory (zram or more RAM)"
    elif [ "$ram" -lt 16 ]; then
      chk warn "RAM: ${ram} GB" "close browsers and local model servers before the world loads; 16 GB is the comfortable floor"
    else
      chk ok "RAM: ${ram} GB"
    fi
  fi

  # the Wine Play will run: WINE override, else <proton>/files/bin/wine, else PATH
  w=$(wine_bin)
  case "$w" in
    */*)
      if [ -x "$w" ]; then
        chk ok "Wine: $w${PROTON:+ (${PROTON##*/})}"
      elif [ -n "$PROTON" ]; then
        chk fail "Wine: $w is not executable" "Quick setup: pick the Proton/GE folder again (it must contain files/bin/wine), or clear the WINE override"
      else
        chk fail "Wine: $w is not executable" "Advanced -> Proton: point it at a folder with files/bin/wine, or clear the WINE override"
      fi ;;
    *)
      if have "$w"; then
        chk ok "Wine: $w (from PATH)"
        p=$(proton_dirs | head -1)
        if [ -n "$p" ] && [ -z "$PROTON" ]; then
          chk warn "Proton: ${p##*/} is installed but not selected" \
                   "Quick setup: pick the build; GE-Proton is what this port is tested with"
        fi
      else
        p=$(proton_dirs | head -1)
        if [ -n "$p" ]; then
          chk fail "Wine: '$w' not found" "a Proton build is installed (${p##*/}): run Quick setup and pick it"
        else
          chk fail "Wine: '$w' not found" "install GE-Proton into ~/.local/share/Steam/compatibilitytools.d (or point Quick setup at a folder with files/bin/wine)"
        fi
      fi ;;
  esac

  # DLLs next to the build
  have_d3d12=0; have_dxil=0
  while IFS= read -r d; do
    [ -f "$d/d3d12.dll" ] && [ -f "$d/d3d12core.dll" ] && have_d3d12=1
    [ -f "$d/dxil.dll" ] && have_dxil=1
  done <<EOF
$(dll_dirs)
EOF
  d=$(dll_dirs | head -1)
  if [ "$have_d3d12" = 1 ]; then
    chk ok "vkd3d-proton DLLs found${d:+ (in $d)}" ""
  else
    chk warn "vkd3d-proton DLLs (d3d12.dll + d3d12core.dll) not next to the build" \
             "copy both from vkd3d-proton master into ${d:-the build folder}; the stock 3.1 copies crash at world entry"
  fi
  if [ "$have_dxil" = 1 ]; then
    chk ok "DXC (dxil.dll) found" ""
  else
    chk warn "DXC (dxil.dll + dxcompiler.dll) not found" \
             "copy dxil.dll and dxcompiler.dll from a DirectXShaderCompiler release into ${d:-the build folder}"
  fi

  if [ -z "$PORT_EXE" ]; then
    chk fail "Scarlight build: not set" "Quick setup (or Advanced -> Scarlight build) knows where your victory.exe is"
  elif [ -f "$PORT_EXE" ]; then
    chk ok "Scarlight build: $PORT_EXE"
  else
    chk fail "Scarlight build: $PORT_EXE does not exist" "Advanced -> Scarlight build: point it at the fresh build"
  fi

  if [ -z "$GAME_EXE" ]; then
    chk fail "Your copy of the game: not set" "Quick setup: pick the .exe of the copy you own (nothing is downloaded)"
  elif [ -f "$GAME_EXE" ]; then
    chk ok "Your copy of the game: $GAME_EXE"
  else
    chk fail "Your copy of the game: $GAME_EXE does not exist" "Quick setup: pick the .exe of the copy you own"
  fi

  if [ -d "$PREFIX" ]; then
    chk ok "Wine prefix: $PREFIX"
  else
    chk warn "Wine prefix: $PREFIX does not exist yet" "it is created on the first launch, which takes a minute; nothing to do"
  fi

  check_title_profile

  # report
  local i=0 fails=0 warns=0
  while [ "$i" -lt ${#CHK_L[@]} ]; do
    case "${CHK_L[$i]}" in fail) fails=$((fails+1)) ;; warn) warns=$((warns+1)) ;; esac
    i=$((i+1))
  done
  CHK_FAILS=$fails; CHK_WARNS=$warns
  return 0
}

show_checks() {
  local i=0 mark
  while [ "$i" -lt ${#CHK_L[@]} ]; do
    case "${CHK_L[$i]}" in
      ok) mark="${C_OK}ok  ${C_R}" ;;
      warn) mark="${C_WARN}warn${C_R}" ;;
      *) mark="${C_BAD}FAIL${C_R}" ;;
    esac
    printf '  %s  %s\n' "$mark" "${CHK_T[$i]}"
    if [ -n "${CHK_F[$i]}" ]; then
      printf '        %s%s%s\n' "$C_DIM" "-> ${CHK_F[$i]}" "$C_R"
    fi
    i=$((i+1))
  done
  printf '\n'
  if [ "$CHK_FAILS" -gt 0 ]; then
    printf '  %s%d to fix before this can run.%s' "$C_BAD" "$CHK_FAILS" "$C_R"
  elif [ "$CHK_WARNS" -gt 0 ]; then
    printf '  %sReady, with %d note(s).%s' "$C_WARN" "$CHK_WARNS" "$C_R"
  else
    printf '  %sAll good.%s' "$C_OK" "$C_R"
  fi
  printf '\n\n'
}

# ---------- env + summary --------------------------------------------------
ENVVARS=()
build_env() {
  ENVVARS=()
  local t keys=""
  ENVVARS+=("WINEPREFIX=$PREFIX")
  ENVVARS+=("WINEDLLOVERRIDES=d3d12,d3d12core,dxgi,d3d11,d3d10core,d3dcompiler_47=n,b")
  # a DLL folder other than the build's own is only used if Wine can see it
  if [ -n "$DLLDIR" ] && [ "$DLLDIR" != "${PORT_EXE%/*}" ]; then
    ENVVARS+=("WINEDLLPATH=$DLLDIR")
  fi
  ENVVARS+=("VKD3D_CONFIG=ignore_shared_fence")
  ENVVARS+=("VICTORY_LOG=$LOG")
  [ -n "$GAME_DIR" ] && ENVVARS+=("VICTORY_GAME_DIR=$GAME_DIR")
  if [ "$WATCHDOG" = off ]; then ENVVARS+=("VICTORY_NO_WATCHDOG=1"); fi
  case "$TARGET" in
    skip) keys="10:Enter,20:Enter,30:Enter,40:Enter" ;;
    window) keys=$(for t in $(seq 10 5 180); do printf '%s:Enter,' "$t"; done | sed 's/,$//') ;;
    save) keys="15:Enter,25:Enter" ;;
  esac
  [ -n "$keys" ] && ENVVARS+=("VICTORY_KEYS=$keys")
  if [ -z "${SCARLIGHT_LAUNCH_CMD:-}" ] && [ "$RT" = on ]; then ENVVARS+=("VICTORY_RAYS=1"); fi
  for t in $MESA; do
    case "$t" in
      mesa-cache) ENVVARS+=("MESA_SHADER_CACHE_MAX_SIZE=10G") ;;
      mesa-nocache) ENVVARS+=("MESA_SHADER_CACHE_DISABLE=true") ;;
      radv-wave32) ENVVARS+=("RADV_PERFTEST=gewave32,pswave32,cswave32") ;;
      radv-stats) ENVVARS+=("RADV_DEBUG=shaderstats") ;;
      radv-isa) ENVVARS+=("RADV_DEBUG=shaders") ;;
      aco-ir) ENVVARS+=("ACO_DEBUG=validateir") ;;
      wsi-imm) ENVVARS+=("MESA_VK_WSI_PRESENT_MODE=immediate") ;;
      vkd3d-cpu) ENVVARS+=("VKD3D_CONFIG=ignore_shared_fence,recycle_command_pools,no_upload_hvv,memory_allocator_skip_clear") ;;
    esac
  done
  # VKD3D_CONFIG may be set twice: merge
  local rd
  rd=$(for e in "${ENVVARS[@]}"; do case "$e" in RADV_DEBUG=*) printf '%s\n' "${e#RADV_DEBUG=}";; esac; done | paste -sd, -)
  if [ -n "$rd" ]; then
    local -a keep=()
    for e in "${ENVVARS[@]}"; do case "$e" in RADV_DEBUG=*) ;; *) keep+=("$e");; esac; done
    keep+=("RADV_DEBUG=$rd"); ENVVARS=("${keep[@]}")
  fi
  return 0
}

env_text() { local e; for e in "${ENVVARS[@]}"; do printf '%s\n' "$e"; done; }

mesa_word() { local t; for t in $MESA; do printf '%s ' "$t"; done; }

q() { printf '%q' "$1"; }

hook_cmd_str() {
  local tpl=${SCARLIGHT_LAUNCH_CMD}
  # the replacement is quoted: with bash's patsub_replacement an unquoted & would
  # expand to the match, and q's backslash before an &
  tpl=${tpl//\{exe\}/"$(q "$GAME_EXE")"}
  tpl=${tpl//\{port_exe\}/"$(q "$PORT_EXE")"}
  tpl=${tpl//\{prefix\}/"$(q "$PREFIX")"}
  printf '%s\n' "$tpl"
}

print_command() {
  local envs w
  build_env
  if [ -n "${SCARLIGHT_LAUNCH_CMD:-}" ]; then
    envs=$(env_text | paste -sd' ' -)
    printf '%s %s\n' "$envs" "$(hook_cmd_str)"
    return
  fi
  w=$(wine_bin)
  envs=$(env_text | paste -sd' ' -)
  printf '%s %s %s run %s --execute\n' "$envs" "$(q "$w")" "$(q "$PORT_EXE")" "$(q "$GAME_EXE")"
}

rt_word() { if [ "$RT" = on ]; then printf 'on'; else printf 'off'; fi; }

preset_word() {
  case "$PRESET" in
    play) printf 'Play' ;;
    perf) printf 'Performance' ;;
    pic) printf 'Picture debug' ;;
    dev) printf 'Developer' ;;
    *) printf '%s' "$PRESET" ;;
  esac
}

target_word() {
  case "$TARGET" in
    normal) printf 'normal start' ;;
    skip) printf 'skip the intros' ;;
    window) printf 'start at the test scene' ;;
    save) printf 'restore a save' ;;
    *) printf '%s' "$TARGET" ;;
  esac
}

show_plan() {
  local drv="" mw=""
  if [ -n "$DRIVER" ]; then
    drv="$DRIVER"; [ -n "$MESA_VER" ] && drv="$drv / Mesa $MESA_VER"; [ -n "$VKVER" ] && drv="$drv / Vulkan $VKVER"
  fi
  printf '%sScarlight - %s preset%s%s\n' "$C_B" "$(preset_word)" "$([ -n "$PROFILE_NAME" ] && printf ' (profile %s)' "$PROFILE_NAME" || printf ' (last setup)')" "$C_R"
  printf '  start      %s\n' "$(target_word)"
  printf '  wine       %s\n' "$(wine_bin)"
  printf '  prefix     %s\n' "$PREFIX"
  printf '  build      %s\n' "${PORT_EXE:-<not set>}"
  printf '  game       %s\n' "${GAME_EXE:-<not set>}"
  [ -n "$DLLDIR" ] && printf '  dlls       %s\n' "$DLLDIR"
  [ -n "$drv" ] && printf '  driver     %s\n' "$drv"
  printf '  options    backend %s, RT %s, watchdog %s, log %s\n' "$BACKEND" "$(rt_word)" \
         "$([ "$WATCHDOG" = off ] && printf 'off' || printf 'on')" "$LOG"
  mw=$(mesa_word); mw=${mw% }
  printf '  mesa       %s\n' "${mw:-driver defaults}"
  printf '  %scommand%s\n' "$C_DIM" "$C_R"
  print_command | fold -s -w 110 | sed 's/^/    /'
  printf '\n'
}

# ---------- profiles -------------------------------------------------------
save_last() {
  local f=$LAST
  {
    printf '# written by scarlight %s\n' "$(date -u +%FT%TZ)"
    printf 'PROFILE_NAME=%s\n' "$(q "$PROFILE_NAME")"
    printf 'PRESET=%s\n' "$(q "$PRESET")"
    printf 'TARGET=%s\n' "$(q "$TARGET")"
    printf 'RT=%s\n' "$(q "$RT")"
    printf 'MESA=%s\n' "$(q "$MESA")"
    printf 'LOG=%s\n' "$(q "$LOG")"
    printf 'WATCHDOG=%s\n' "$(q "$WATCHDOG")"
    printf 'BACKEND=%s\n' "$(q "$BACKEND")"
    printf 'PROTON=%s\n' "$(q "$PROTON")"
    printf 'WINE=%s\n' "$(q "$WINE")"
    printf 'PORT_EXE=%s\n' "$(q "$PORT_EXE")"
    printf 'GAME_EXE=%s\n' "$(q "$GAME_EXE")"
    printf 'GAME_DIR=%s\n' "$(q "$GAME_DIR")"
    printf 'DLLDIR=%s\n' "$(q "$DLLDIR")"
    printf 'PREFIX=%s\n' "$(q "$PREFIX")"
    printf 'DURATION=%s\n' "$(q "$DURATION")"
    printf 'MODE=%s\n' "$(q "$MODE")"
    # plain ifs, not `[ ... ] && ...`: an empty TREE/SAVE must not make the last
    # command of the group fail and look like a write error
    if [ -n "$TREE" ]; then printf 'TREE=%s\n' "$(q "$TREE")"; fi
    if [ -n "$SAVE" ]; then printf 'SAVE=%s\n' "$(q "$SAVE")"; fi
  } 2>/dev/null > "$f.tmp" || { rm -f "$f.tmp"; printf '%s: could not save the last choices\n' "$PROG" >&2; return 1; }
  mv "$f.tmp" "$f" 2>/dev/null || { rm -f "$f.tmp"; printf '%s: could not replace %s\n' "$PROG" "$f" >&2; return 1; }
  return 0
}

save_profile() { # save_profile <name>
  local name=$1 f
  f=$CONFIG_DIR/$name.env
  {
    printf '# scarlight profile %s, written %s\n' "$name" "$(date -u +%FT%TZ)"
    printf 'PRESET=%s\n' "$(q "$PRESET")"
    printf 'TARGET=%s\n' "$(q "$TARGET")"
    printf 'RT=%s\n' "$(q "$RT")"
    printf 'MESA=%s\n' "$(q "$MESA")"
    printf 'LOG=%s\n' "$(q "$LOG")"
    printf 'WATCHDOG=%s\n' "$(q "$WATCHDOG")"
    printf 'BACKEND=%s\n' "$(q "$BACKEND")"
    printf 'PROTON=%s\n' "$(q "$PROTON")"
    printf 'WINE=%s\n' "$(q "$WINE")"
    printf 'PORT_EXE=%s\n' "$(q "$PORT_EXE")"
    printf 'GAME_EXE=%s\n' "$(q "$GAME_EXE")"
    printf 'GAME_DIR=%s\n' "$(q "$GAME_DIR")"
    printf 'DLLDIR=%s\n' "$(q "$DLLDIR")"
    printf 'PREFIX=%s\n' "$(q "$PREFIX")"
  } 2>/dev/null > "$f.tmp" || { rm -f "$f.tmp"; die "cannot write $f (the previous profile is untouched)"; }
  mv "$f.tmp" "$f" || { rm -f "$f.tmp"; die "cannot replace $f (the previous profile is untouched)"; }
  printf 'saved profile %s\n' "$f"
}

# ---------- presets -------------------------------------------------------
apply_preset() {
  case "$1" in
    play)
      PRESET=play; RT=off; MESA="mesa-cache"; TARGET=normal; LOG=info; WATCHDOG=off ;;
    perf)
      PRESET=perf; RT=off; MESA="mesa-cache"; TARGET=normal; LOG=info; WATCHDOG=off
      mesa_flag_ok radv-wave32 && MESA="$MESA radv-wave32" ;;
    pic)
      PRESET=pic; MESA="mesa-cache"; TARGET=normal; LOG=debug; WATCHDOG=off
      mesa_flag_ok radv-stats && MESA="$MESA radv-stats"
      if rt_supported; then RT=on; fi ;;
    dev)
      PRESET=dev; RT=off; MESA="mesa-cache"; TARGET=skip; LOG=debug; WATCHDOG=on ;;
  esac
  return 0
}

# ---------- first-run wizard ---------------------------------------------
wizard() {
  local p list i out
  detect_gpu >/dev/null 2>&1 || true
  list=$(proton_dirs)
  if [ -z "$PROTON" ] && [ -n "$list" ]; then
    local -a items=()
    i=1
    while IFS= read -r p; do
      items+=("$p" "$(printf '%02d' "$i") ${p##*/}")
      i=$((i+1))
    done <<EOF
$list
EOF
    out=$(ui_pick "Quick setup 1/3: Proton" "which Wine do you run? GE-Proton is what Scarlight is tested with" "${items[@]}") || return 1
    PROTON=$out
  fi
  if [ -z "$PROTON" ]; then
    PROTON=$(ui_input "Quick setup 1/3: Proton" "folder of a Proton/GE build (contains files/bin/wine)" "${PROTON:-$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-14}") || return 1
  fi
  [ -x "$PROTON/files/bin/wine" ] || ui_show "Proton" "$PROTON has no files/bin/wine - Wine may not start. You can change it later in Advanced."

  GAME_EXE=$(ui_input "Quick setup 2/3: your game" "full path of the .exe of the copy you own (nothing is downloaded)" "$GAME_EXE") || return 1
  [ -n "$GAME_EXE" ] || return 1
  GAME_DIR=${GAME_EXE%/*}

  if [ -z "$PORT_EXE" ]; then
    for p in "${PWD%/}/target/x86_64-pc-windows-msvc/release/victory.exe" "${GAME_DIR:-.}/victory.exe"; do
      [ -f "$p" ] && { PORT_EXE=$p; break; }
    done
  fi
  PORT_EXE=$(ui_input "Quick setup 2/3: Scarlight build" "the victory.exe you built (target/x86_64-pc-windows-msvc/release/)" "${PORT_EXE:-${PWD%/}/target/x86_64-pc-windows-msvc/release/victory.exe}") || return 1

  DLLDIR=$(ui_input "Quick setup 3/3: DLL folder" "where dxgi/d3d12/d3d12core/dxil go (empty = next to the build)" "${DLLDIR:-}") || true
  [ -n "$DLLDIR" ] || DLLDIR=${PORT_EXE%/*}

  printf 'Quick setup: proton %s, game %s, dlls %s\n' "$PROTON" "$GAME_EXE" "$DLLDIR" >&2
  save_profile default
  printf 'wrote %s/default.env\n' "$CONFIG_DIR" >&2
  return 0
}

