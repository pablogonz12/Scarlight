menu_advanced() {
  local c v=""
  while :; do
    c=$(ui_pick "Advanced" "everything here is saved for next time" \
      rt "Ray tracing: $(rt_word)$(rt_supported || printf ' (not in this build)')" \
      backend "Backend: $BACKEND" \
      mesa "Mesa / driver options: $(mesa_word)" \
      log "Log level: $LOG" \
      watchdog "Watchdog: $([ "$WATCHDOG" = off ] && printf 'off (never stops on its own)' || printf 'on')" \
      target "Where to start: $(target_word)" \
      proton "Proton: ${PROTON:-<not set>}" \
      build "Scarlight build: ${PORT_EXE:-<not set>}" \
      title "Game exe: ${GAME_EXE:-<not set>}" \
      dlls "DLL folder: ${DLLDIR:-<next to the build>}" \
      prefix "Wine prefix: $PREFIX" \
      back "Back") || return 0
    case "$c" in
      back) return 0 ;;
      rt)
        if ! rt_supported; then
          ui_show "Ray tracing" "This build has no ray-tracing path (no '-rt' build and no SCARLIGHT_RT_SUPPORTED=1). It stays off."
          continue
        fi
        if [ "$RT" = on ]; then RT=off; else RT=on; fi ;;
      backend)
        local b
        b=$(ui_pick "Backend" "D3D12 through Proton is the supported path" \
          d3d12 "d3d12 (Proton, stable) - what ships today" \
          vulkan "vulkan (native, experimental) - coming later" \
          back "Back") || continue
        case "$b" in
          d3d12) BACKEND=d3d12 ;;
          vulkan) ui_show "Backend" "The native Vulkan backend is not ready yet; Scarlight still starts through D3D12 + vkd3d-proton. Backend stays d3d12." ;;
        esac ;;
      mesa)
        local -a items=()
        local t st
        for t in $(mesa_available_tags); do
          st=OFF
          case " $MESA " in *" $t "*) st=ON ;; esac
          items+=("$t" "$(mesa_flag_label "$t")" "$st")
        done
        if [ ${#items[@]} -eq 0 ]; then
          ui_show "Mesa options" "This driver reported no Mesa switches the launcher trusts, so there is nothing to set."
          continue
        fi
        MESA=$(ui_check "Mesa / driver options" "only switches the installed Mesa really has; empty = driver defaults" "${items[@]}") || continue
        [ -n "${MESA// /}" ] || MESA=""
        ;;
      log)
        LOG=$(ui_pick "Log level" "debug and trace write far more; info is what a bug report needs" \
          info "info - normal, small log" \
          debug "debug - per-pipeline detail, bigger and slower" \
          trace "trace - everything, slow" \
          off "off - no log at all") || continue ;;
      watchdog) if [ "$WATCHDOG" = off ]; then WATCHDOG=on; else WATCHDOG=off; fi ;;
      target)
        TARGET=$(ui_pick "Where to start" "scripted key presses need a diagnostics build" \
          normal "Normal start - press nothing" \
          skip "Skip the intros - Enter every 10 s for the first 40 s" \
          window "Test scene - Enter through the intro, stop at the first idle view" \
          save "Restore a save - Enter twice, load your snapshot first") || continue ;;
      proton)
        local pv p2
        local -a pitems=()
        while IFS= read -r p2; do pitems+=("$p2" "${p2##*/}"); done <<EOF
$(proton_dirs)
EOF
        pv=$(ui_pick "Proton" "the Wine Scarlight runs in" \
          keep "Keep ${PROTON:-<not set>}" \
          other "Type a path..." \
          ${pitems[@]+"${pitems[@]}"}) || continue
        case "$pv" in
          keep) : ;;
          other) v=$(ui_input "Proton" "folder with files/bin/wine" "$PROTON") && PROTON=$v ;;
          *) PROTON=$pv ;;
        esac ;;
      # each edit lands in a temporary first: a cancelled prompt must keep the old value
      build) v=$(ui_input "Scarlight build" "the victory.exe you built" "$PORT_EXE") && PORT_EXE=$v ;;
      title) v=$(ui_input "Game exe" "the .exe of the copy you own" "$GAME_EXE") && {
               GAME_EXE=$v; [ -n "$GAME_EXE" ] && GAME_DIR=${GAME_EXE%/*}; } ;;
      dlls) v=$(ui_input "DLL folder" "where dxgi/d3d12/d3d12core/dxil live ('-' clears: use the build's own)" "$DLLDIR") && {
              case "$v" in -|none|clear) DLLDIR="" ;; *) DLLDIR=$v ;; esac; } ;;
      prefix) v=$(ui_input "Wine prefix" "WINEPREFIX for this setup" "$PREFIX") && PREFIX=$v ;;
    esac
  done
}

copy_text() { # copy_text <file>
  local f=$1
  if have wl-copy; then wl-copy < "$f" && printf 'copied to the Wayland clipboard\n'
  elif have xclip; then xclip -selection clipboard < "$f" && printf 'copied to the clipboard\n'
  elif have xsel; then xsel -b < "$f" && printf 'copied to the clipboard\n'
  else printf 'no clipboard tool (wl-copy, xclip, xsel): the lines are below\n\n'; cat "$f"; fi
}

menu_logs() {
  local c newest
  while :; do
    newest=$(find "$LOG_DIR" -maxdepth 1 -name '*.log' -printf '%T@\t%p\n' 2>/dev/null | sort -nr | head -1 | cut -f2-)
    c=$(ui_pick "Logs" "${newest:-no launch log yet}" \
      open "Open the last launch log" \
      copy "Copy the last 50 lines (bug report)" \
      crashes "Copy the last 50 lines of crashes.log from the data folder" \
      dir "Where the logs are" \
      back "Back") || return 0
    case "$c" in
      back) return 0 ;;
      open)
        if [ -z "$newest" ]; then ui_show "Logs" "No launch log yet: start once and it is written to $LOG_DIR"; continue; fi
        if have less; then less "$newest" || true; else tail -100 "$newest"; fi ;;
      copy)
        if [ -z "$newest" ]; then ui_show "Logs" "No launch log yet: start once and it is written to $LOG_DIR"; continue; fi
        tail -50 "$newest" > "$LOG_DIR/last-50.txt"
        copy_text "$LOG_DIR/last-50.txt" | while IFS= read -r l; do printf '%s\n' "$l" >&2; done ;;
      crashes)
        local cf="${GAME_DIR:-}/crashes.log"
        if [ -f "$cf" ]; then tail -50 "$cf" > "$LOG_DIR/crashes-50.txt"; copy_text "$LOG_DIR/crashes-50.txt" >&2
        else ui_show "Logs" "No crashes.log in ${GAME_DIR:-the game folder}." ; fi ;;
      dir) ui_show "Logs" "Launcher logs: $LOG_DIR
crashes.log, if your build writes one, sits in the game's data folder: ${GAME_DIR:-<not set>}" ;;
    esac
  done
}

menu_help() {
  ui_show "Help" "Scarlight launcher

Play starts the setup you saved last; the summary and the exact command are shown before anything runs.
Quick setup asks three things: your Proton/GE folder, the .exe of the copy you own, and the folder with the DXVK/vkd3d/DXC DLLs.
Presets set everything at once; Advanced changes one thing and remembers it.

Everything lives in $CONFIG_DIR (last.env plus any *.env profile). Prefix: $PREFIX. Logs: $LOG_DIR.
Nothing here downloads the game; bring your own copy.

Flags: --check (machine report), --dry-run (print the command), --profile NAME, --list-profiles, --save-profile NAME, --ui gum|fzf|whiptail|dialog|select, --help.
Docs: docs/linux.md in the repository."
}

# ---------- launch -------------------------------------------------------
do_launch() {
  local logf cmd
  build_env
  mkdir -p "$LOG_DIR"
  logf=$LOG_DIR/$(date -u +%Y%m%dT%H%M%SZ)-$PRESET.log
  save_last
  export SCARLIGHT_GAME_EXE=$GAME_EXE SCARLIGHT_PORT_EXE=$PORT_EXE SCARLIGHT_PREFIX=$PREFIX
  export SCARLIGHT_PROTON=$PROTON SCARLIGHT_PRESET=$PRESET SCARLIGHT_TARGET=$TARGET
  export SCARLIGHT_LOG=$LOG SCARLIGHT_WATCHDOG=$WATCHDOG SCARLIGHT_RT=$RT SCARLIGHT_MESA=$MESA
  export SCARLIGHT_DURATION=$DURATION SCARLIGHT_MODE=$MODE SCARLIGHT_TREE=$TREE
  export SCARLIGHT_SAVE=$SAVE SCARLIGHT_SCENE=$SCENE SCARLIGHT_PROFILE=$PROFILE_NAME
  export SCARLIGHT_BACKEND=$BACKEND
  printf '# scarlight %s preset=%s\n' "$(date -u +%FT%TZ)" "$PRESET" > "$logf"
  print_command >> "$logf"
  local envq=""
  envq=$(printf '%q ' "${ENVVARS[@]}")
  if [ -n "${SCARLIGHT_LAUNCH_CMD:-}" ]; then
    cmd=$(hook_cmd_str)
    # shellcheck disable=SC2086
    ( eval "env $envq$cmd" ) 2>&1 | tee -a "$logf"
    return "${PIPESTATUS[0]}"
  fi
  ( env "${ENVVARS[@]}" "$(wine_bin)" "$PORT_EXE" run "$GAME_EXE" --execute ) 2>&1 | tee -a "$logf"
  return "${PIPESTATUS[0]}"
}

# ---------- main ---------------------------------------------------------
if [ "$MODE_CMD" = check ]; then
  printf '%sScarlight system check%s\n\n' "$C_B" "$C_R"
  run_checks
  show_checks
  [ "$CHK_FAILS" -gt 0 ] && exit 1
  exit 0
fi

if [ "$MODE_CMD" = dry ]; then
  run_checks >/dev/null 2>&1
  printf '%sScarlight system check%s\n\n' "$C_B" "$C_R"
  show_checks
  show_plan
  [ -n "$WANT_SAVE" ] && save_profile "$WANT_SAVE"
  exit 0
fi

if [ -n "$WANT_SAVE" ]; then
  # a plain save needs no menu: it records whatever was loaded (last.env or --profile)
  save_profile "$WANT_SAVE"
  exit 0
fi

if [ ! -t 0 ]; then
  printf '%s: no terminal for the menu. Use --check, --dry-run or --profile NAME.\n' "$PROG" >&2
  run_checks; show_checks; show_plan
  exit 2
fi

run_checks
printf '\n%sScarlight%s  %slauncher v2%s\n\n' "$C_B" "$C_R" "$C_DIM" "$C_R"
show_checks
ui_pause

while :; do
  c=$(ui_pick "Scarlight" "system check done - Play uses the last setup" \
    play "Play - $(preset_word) preset, $(target_word), RT $(rt_word), log $LOG" \
    quick "Quick setup - Proton, game exe, DLL folder" \
    presets "Presets - Play, Performance, Picture debug, Developer" \
    advanced "Advanced - ray tracing, Mesa options, backend, log level, watchdog" \
    logs "Logs - open the last log, copy the last 50 lines" \
    help "Help - what everything means" \
    quit "Quit") || exit 0
  case "$c" in
    quit) save_last; exit 0 ;;
    quick) wizard || true; run_checks; show_checks ;;
    presets) menu_presets; save_last ;;
    advanced) menu_advanced; save_last ;;
    logs) menu_logs ;;
    help) menu_help ;;
    play)
      if [ -z "$GAME_EXE" ] || [ -z "$PORT_EXE" ]; then
        ui_show "First run" "There is no setup yet. Quick setup asks three things and then Play works."
        wizard || continue
        run_checks
        continue
      fi
      run_checks >/dev/null 2>&1
      show_checks
      show_plan
      if [ "$CHK_FAILS" -gt 0 ]; then
        ui_show "Not ready" "Something is red above. Fix it, or open Advanced to point the launcher at another build."
        continue
      fi
      if [ "$ASSUME_YES" = 0 ]; then
        ui_confirm "Start?" "Start Scarlight now with the settings above?" || {
          n=$(ui_input "Save profile" "save this selection as a profile (name, empty = no)" "") || n=""
          [ -n "$n" ] && save_profile "$n"
          continue
        }
      fi
      do_launch
      printf '\n%sScarlight exited with status %s%s\n' "$C_DIM" "$?" "$C_R"
      exit 0 ;;
  esac
done
