# Example scarlight profile. Copy it to
#   ${XDG_CONFIG_HOME:-~/.config}/scarlight/<name>.env
# and start it with:  scarlight --profile <name>
#
# Every value is a shell word, so quote anything with spaces.

# Play | Performance | Picture debug | Developer (free text is kept as-is)
PRESET='Performance'

# normal | skip (intros) | window (test scene) | save
TARGET='normal'

# on | off - only when the build has the ray-tracing path
RT='off'

# space separated Mesa switch tags; the launcher only offers what your Mesa has
#   mesa-cache mesa-nocache radv-wave32 radv-stats radv-isa aco-ir wsi-imm vkd3d-cpu
MESA='mesa-cache radv-wave32'

# info | debug | trace | off
LOG='info'

# off = VICTORY_NO_WATCHDOG=1 (the port never stops itself), on = keep the watchdog
WATCHDOG='off'

# d3d12 is the only backend that ships today
BACKEND='d3d12'

PROTON="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-14"
WINE=''
PORT_EXE="$HOME/src/Scarlight/target/x86_64-pc-windows-msvc/release/victory.exe"
GAME_EXE="$HOME/game-data/the-title.exe"
GAME_DIR=''
DLLDIR="$HOME/src/Scarlight/target/x86_64-pc-windows-msvc/release"
PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/scarlight/prefix"
